# Docker environment variables — copy to .env and fill in real values
# This file is safe to commit. The .env file is NOT.

# ─── MongoDB ──────────────────────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me_in_production

# ─── Security ─────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars

# ─── AI APIs ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ─── Google OAuth ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=325288400467-aegvvnbetjn04vjgi2ku4iugca2ak4tj.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ─── URLs ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
