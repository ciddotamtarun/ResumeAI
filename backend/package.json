{
  "name": "resume-simulator-backend",
  "version": "1.0.0",
  "description": "Resume Simulator API Server",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "node -r ts-node/register --test test/acceptanceCriteria.test.ts test/emailValidator.test.ts test/otp.test.ts test/parser.test.ts test/registrationFlow.test.ts test/ai-and-resume.service.test.ts test/aiFixValidation.test.ts test/interviewFlow.test.ts test/googleAuthFlow.test.ts test/roadmapFlow.test.ts",
    "test:acceptance": "node -r ts-node/register --test test/acceptanceCriteria.test.ts",
    "seed": "npm run build && node dist/scripts/seed.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.15.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.7.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.2.1",
    "openai": "^4.52.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
